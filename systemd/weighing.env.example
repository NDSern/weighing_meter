# Credential template for /etc/weighing-meter/weighing.env
#
# Install as root, mode 0600:
#   sudo install -d -m 0755 /etc/weighing-meter
#   sudo install -m 0600 weighing.env.example /etc/weighing-meter/weighing.env
#   sudo chown root:root /etc/weighing-meter/weighing.env
#
# Environment values override config.py and config.local.py.
# Leave a value unset (or empty) to fall back to config.local.py.

# Bridge identity — also selects the per-host policy block in config.py
WEIGHING_WEIGHBRIDGE_ID=

# Cameras — either set the full URLs or just the shared credentials
WEIGHING_RTSP_USERNAME=
WEIGHING_RTSP_PASSWORD=
WEIGHING_RTSP_URL=
WEIGHING_RTSP_URL_2=
WEIGHING_RTSP_URL_3=

# MQTT broker
WEIGHING_MQTT_HOST=
WEIGHING_MQTT_PORT=
WEIGHING_MQTT_USERNAME=
WEIGHING_MQTT_PASSWORD=

# MinIO object storage
WEIGHING_MINIO_ENDPOINT=
WEIGHING_MINIO_ACCESS_KEY=
WEIGHING_MINIO_SECRET_KEY=